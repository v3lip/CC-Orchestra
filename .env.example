# Copy to .env (or run `npm run setup`, which generates a random password).
ADMIN_PASSWORD=change-me
# 127.0.0.1 is enough for single-player: the game and the backend run on the same PC.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Public base URL turtles use to reach the backend (shown in install instructions).
PUBLIC_URL=http://127.0.0.1:8787
